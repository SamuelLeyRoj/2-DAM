<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_slr" model="ir.ui.view">
        <field name="name">product.template.form.inherit.slr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <field name="categ_id" position="before">
                <field name="slr_fec_lanz" 
                       invisible="detailed_type != 'service'"/>
                
                <field name="slr_activ" 
                       readonly="True" 
                       invisible="detailed_type != 'service'"/>
                       
                <field name="slr_ilust" widget="image" class="oe_avatar"/>
            </field>

        </field>
    </record>

    <record id="view_product_template_tree_inherit_slr" model="ir.ui.view">
        <field name="name">product.template.tree.inherit.slr</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='name']" position="before">
                <field name="slr_ilust" widget="image" options='{"size": [40, 40]}' string="Ilust."/>
            </xpath>

            <field name="name" position="after">
                <field name="slr_activ" optional="show"/>
            </field>

        </field>
    </record>
</odoo>