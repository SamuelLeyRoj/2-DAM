<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.safa.repasito1.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Pane prefHeight="272.0" prefWidth="200.0">
      <children>
         <Label layoutX="6.0" layoutY="34.0" text="NombreServidor" />
         <TextField fx:id="nombewServidor" layoutX="3.0" layoutY="59.0" prefHeight="25.0" prefWidth="93.0" />
         <Label layoutX="132.0" layoutY="32.0" text="Puerto" />
         <TextField fx:id="puerto" layoutX="110.0" layoutY="60.0" prefHeight="25.0" prefWidth="82.0" />
         <TextField fx:id="nombreUsuario" layoutX="3.0" layoutY="115.0" prefHeight="25.0" prefWidth="93.0" />
         <TextField fx:id="Clave" layoutX="109.0" layoutY="115.0" prefHeight="25.0" prefWidth="82.0" />
         <Label layoutX="110.0" layoutY="94.0" text="Clave" />
         <TextField fx:id="Asunto" layoutX="105.0" layoutY="171.0" prefHeight="25.0" prefWidth="93.0" />
         <TextField fx:id="nombreDestinatario" layoutX="3.0" layoutY="171.0" prefHeight="25.0" prefWidth="93.0" />
         <Label layoutX="7.0" layoutY="94.0" text="NombreUsuario" />
         <TextField fx:id="Contenido" layoutX="3.0" layoutY="223.0" prefHeight="25.0" prefWidth="93.0" />
         <Label layoutX="112.0" layoutY="150.0" text="Subject" />
         <Label layoutX="3.0" layoutY="206.0" text="Contenido" />
         <Label layoutX="6.0" layoutY="150.0" text="Destinatario" />
      </children>
   </Pane>

    <Label fx:id="welcomeText" />
   <Pane prefHeight="84.0" prefWidth="200.0">
      <children>
          <Button fx:id="btnDesconectar" layoutX="100.0" layoutY="14.0" onAction="#btnDesconectarAccion" text="Desconectar" />
         <Button fx:id="btnEnviarMensaje" layoutX="46.0" layoutY="45.0" mnemonicParsing="false" onAction="#btnEnviarMensajeAc" text="EnviarMensaje" />
         <Button fx:id="btnConectar" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#btnConectarAccion" text="Conectar" />
      </children>
   </Pane>
</VBox>
